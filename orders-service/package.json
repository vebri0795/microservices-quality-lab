{
  "name": "orders-service",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=integration.test.ts --testTimeout=10000",
    "test:pact": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=pact.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$",
      "\\.pact\\.test\\.ts$"
    ]
  }
}
