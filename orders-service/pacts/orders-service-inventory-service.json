{
  "consumer": {
    "name": "orders-service"
  },
  "interactions": [
    {
      "description": "a request to get sku-1",
      "providerStates": [
        {
          "name": "sku-1 exists in the catalog"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/inventory/sku-1"
      },
      "response": {
        "body": {
          "price": 10,
          "quantity": 20,
          "sku": "sku-1"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to reserve 1 unit of sku-1",
      "providerStates": [
        {
          "name": "sku-1 has enough stock"
        }
      ],
      "request": {
        "body": {
          "quantity": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/inventory/sku-1/reserve"
      },
      "response": {
        "body": {
          "remaining": 19,
          "sku": "sku-1"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.remaining": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to reserve more stock than available",
      "providerStates": [
        {
          "name": "sku-1 does not have enough stock"
        }
      ],
      "request": {
        "body": {
          "quantity": 9999
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/inventory/sku-1/reserve"
      },
      "response": {
        "body": {
          "error": "insufficient stock"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 409
      }
    },
    {
      "description": "una peticion para obtener sku-1",
      "providerStates": [
        {
          "name": "sku-1 existe en el catalogo"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/inventory/sku-1"
      },
      "response": {
        "body": {
          "price": 10,
          "quantity": 20,
          "sku": "sku-1"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "una peticion para reservar 1 unidad de sku-1",
      "providerStates": [
        {
          "name": "sku-1 tiene stock suficiente"
        }
      ],
      "request": {
        "body": {
          "quantity": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/inventory/sku-1/reserve"
      },
      "response": {
        "body": {
          "remaining": 19,
          "sku": "sku-1"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.remaining": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "una peticion para reservar mas stock del disponible",
      "providerStates": [
        {
          "name": "sku-1 no tiene stock suficiente"
        }
      ],
      "request": {
        "body": {
          "quantity": 9999
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/inventory/sku-1/reserve"
      },
      "response": {
        "body": {
          "error": "insufficient stock"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 409
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "inventory-service"
  }
}